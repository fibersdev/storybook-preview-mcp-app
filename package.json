{
  "name": "storybook-preview-mcp-app",
  "version": "0.2.0",
  "private": true,
  "description": "Show a Storybook story live in the chat, styled and clickable, as an MCP App.",
  "license": "MIT",
  "bin": {
    "storybook-preview-mcp-app": "server/server.mjs"
  },
  "type": "module",
  "scripts": {
    "fmt": "bun fmt .",
    "fmt:check": "bun fmt --check .",
    "lint": "oxlint -c .oxlintrc.json --deny-warnings server test scripts",
    "typecheck": "bun check --no-script",
    "check:versions": "node scripts/check-versions.mjs",
    "test:unit": "node --test test/unit/*.test.mjs",
    "test:e2e": "node --test --test-concurrency=1 test/e2e/*.test.mjs",
    "fixtures:install": "node scripts/install-fixtures.mjs",
    "verify": "bun run fmt:check && bun run lint && bun run typecheck && bun run check:versions && bun run test:unit"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "oxlint": "1.90.0",
    "playwright": "^1.64.1"
  },
  "engines": {
    "node": ">=20"
  }
}
